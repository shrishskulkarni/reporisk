  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
